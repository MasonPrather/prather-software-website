{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prather-software-staging",
  "account_id": "901d7b0a79a15aaa0f84fbca1bbb2ad5",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "staging.prathersoftware.com", "custom_domain": true },
  ],
  "kv_namespaces": [
    {
      "binding": "MONITORING_STATE",
      "id": "d5bf5f248de54349865abf73f508fa50",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  "vars": {
    "SITE_INDEXING": "disabled",
    "CONTACT_ENABLED": "false",
    "CONTACT_DELIVERY_VERIFIED": "false",
    "ALLOWED_ORIGIN": "https://staging.prathersoftware.com",
    "TURNSTILE_HOSTNAME": "staging.prathersoftware.com",
    "CONTACT_FROM": "mason@prathersoftware.com",
    "CONTACT_TO": "mason@prathersoftware.com",
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "env": {
    "production": {
      "name": "prather-software-website",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "prathersoftware.com", "custom_domain": true },
        { "pattern": "www.prathersoftware.com", "custom_domain": true },
      ],
      "kv_namespaces": [
        {
          "binding": "MONITORING_STATE",
          "id": "9758844c87e646a48591e673ef40ae2f",
        },
      ],
      "vars": {
        "SITE_INDEXING": "enabled",
        "CONTACT_ENABLED": "false",
        "CONTACT_DELIVERY_VERIFIED": "false",
        "ALLOWED_ORIGIN": "https://prathersoftware.com",
        "TURNSTILE_HOSTNAME": "prathersoftware.com",
        "CONTACT_FROM": "mason@prathersoftware.com",
        "CONTACT_TO": "mason@prathersoftware.com",
      },
      "ratelimits": [
        {
          "name": "CONTACT_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
