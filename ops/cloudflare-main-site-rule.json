{
  "name": "Website configuration",
  "kind": "zone",
  "phase": "http_config_settings",
  "rules": [
    {
      "action": "set_config",
      "expression": "(http.host in {\"prathersoftware.com\" \"www.prathersoftware.com\" \"staging.prathersoftware.com\"})",
      "action_parameters": {
        "disable_rum": true
      },
      "description": "Disable unintended analytics on website and contact staging",
      "enabled": true
    }
  ]
}
