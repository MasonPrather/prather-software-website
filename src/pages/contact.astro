---
import Base from '../layouts/Base.astro';
---
<Base title="Contact | Prather Software"><section class="pagehero"><div class="wrap"><div class="eyebrow">CONTACT</div><h1>Let's build something useful.</h1><p>Have a project, product question, or partnership idea? Start a conversation.</p></div></section><section class="section"><div class="wrap grid"><div><h2 style="font-size:2.5rem">Tell us what you need.</h2><p class="muted">We welcome software engineering inquiries, product questions, and partnership conversations.</p><p class="muted">The secure submission endpoint is being configured. The form will be enabled only after spam protection, server validation, and delivery are verified.</p></div><form class="card" onsubmit="return false"><div class="field"><label for="name">Your name</label><input id="name" name="name" required disabled/></div><div class="field"><label for="email">Email address</label><input id="email" type="email" name="email" required disabled/></div><div class="field"><label for="category">Inquiry type</label><select id="category" name="category" disabled><option>Project consultation</option><option>Product support</option><option>Partnership</option><option>General</option></select></div><div class="field"><label for="message">Project details</label><textarea id="message" name="message" disabled></textarea></div><button class="button" type="submit" disabled aria-describedby="form-note">Submissions coming soon</button><p id="form-note" class="muted" style="font-size:.8rem">Not accepting submissions yet. No data is transmitted.</p></form></div></section></Base>
