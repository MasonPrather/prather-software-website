---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import WorkCard from '../components/WorkCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { getCollection } from 'astro:content';
const projects = (
  await getCollection('work', ({ data }) => data.published)
).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const experience = projects.filter(
  (project) => project.data.category !== 'Prather Software client engagement',
);
const clientWork = projects.filter(
  (project) => project.data.category === 'Prather Software client engagement',
);
---

<Base
  title="Our Work & Engineering Experience | Prather Software"
  description="Explore Mason Prather’s academic research and prior professional engineering, clearly attributed and distinguished from Prather Software client engagements."
>
  <PageHero
    eyebrow="Our Work"
    title="Experience, with the context that matters."
    description="Selected engineering work from academic research and prior professional experience. Each overview identifies its origin and contribution; these projects are not presented as Prather Software client engagements."
  />
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Selected experience</p>
      <h2>Engineering in practice.</h2>
      <div class="grid">
        {experience.map((entry) => (
          <WorkCard entry={entry} />
        ))}
      </div>
      <aside class="publication-note">
        <h3>About these overviews</h3>
        <p class="muted">
          These summaries describe the founder’s experience. Project names are
          descriptive, and technical detail is limited to the information
          supplied for publication. Full case studies and supporting artifacts
          remain subject to review and any required permission.
        </p>
      </aside>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Prather Software client work</p>
      <h2>Client engagements.</h2>
      {clientWork.length > 0 ? (
        <div class="grid">
          {clientWork.map((entry) => (
            <WorkCard entry={entry} />
          ))}
        </div>
      ) : (
        <p class="muted">
          No client case studies are published yet. Verified Prather Software
          engagements will be added when approved for publication.
        </p>
      )}
    </div>
  </section>
  <ContactCTA />
</Base>
<style>
  .publication-note {
    max-width: 800px;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid #dddde0;
  }
</style>
