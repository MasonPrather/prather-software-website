---
import Base from '../layouts/Base.astro';

const description =
  'An early Windows build of the Director’s Cut tower roguelike. Explore its tower floors solo or team up with a friend using private room-code co-op.';
---

<Base
  title="Director’s Cut: Tower Prototype | Prather Software"
  description={description}
  noindex
>
  <section class="section">
    <div class="wrap tower-page">
      <p class="eyebrow">Prather Software / Game prototype</p>
      <h1>
        Director’s Cut:
        <br />
        Tower Prototype
      </h1>
      <p class="version">Alpha 0.2 · Windows 11 (64-bit)</p>
      <p class="description">{description}</p>
      <div class="download-area">
        <a
          class="download-button"
          href="https://downloads.prathersoftware.com/Directors-Cut-Alpha-0.2-Win64-Development.zip"
        >
          Download Alpha 0.2 for Windows
        </a>
        <p class="availability">ZIP size: 608.7 MiB (637,868,409 bytes)</p>
      </div>
      <section class="instructions" aria-labelledby="playtest-heading">
        <h2 id="playtest-heading">Setup</h2>
        <ol>
          <li>
            Download the ZIP and choose <strong>Extract All</strong>.
          </li>
          <li>
            Open the extracted folder and run <code>EpicAIMegaJam.exe</code>.
          </li>
          <li>
            Choose <strong>New Game</strong> to start playing solo.
          </li>
          <li>
            To join a friend, use the Expedition Table in the hub, choose{' '}
            <strong>Private Co-op → Join Room</strong>, and enter the host’s
            room code. Both players need the same Alpha 0.2 build.
          </li>
        </ol>
        <p class="playtest-note">
          For the three-floor preview, run this from the extracted folder:
          <code>
            EpicAIMegaJam.exe -JamProceduralTower -JamFoundrySlice
            -saveddirsuffix=JamWinAlpha02
          </code>
          . Private room-code co-op is a playtest feature; the two-PC and WAN
          checks are still pending.
        </p>
      </section>
      <details class="older-builds">
        <summary>Older builds</summary>
        <a href="https://downloads.prathersoftware.com/DirectorCut-TowerPrototype-Alpha-0.1-Win64.zip">
          Alpha 0.1 for Windows
        </a>
      </details>
    </div>
  </section>
</Base>

<style>
  .tower-page {
    max-width: 850px;
    padding-block: clamp(28px, 6vw, 72px);
  }
  h1 {
    max-width: 780px;
  }
  .version {
    display: inline-block;
    margin: 0 0 24px;
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--brand);
    font: 600 0.76rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .description {
    max-width: 740px;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.8;
  }
  .download-area {
    margin-top: 34px;
  }
  .download-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 390px);
    min-height: 58px;
    padding: 15px 22px;
    border: 0;
    border-radius: 2px;
    background: var(--brand);
    color: var(--white);
    font-weight: 650;
    font-size: 1rem;
    text-align: center;
    text-decoration: none;
  }
  .download-button:hover {
    background: var(--brand-hover);
  }
  .availability {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
  .instructions {
    max-width: 760px;
    margin-top: clamp(36px, 7vw, 64px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .instructions h2 {
    margin-block: 10px 20px;
    font-size: clamp(1.65rem, 3.5vw, 2.4rem);
  }
  .instructions ol {
    display: grid;
    gap: 12px;
    padding-left: 1.5rem;
    color: var(--muted);
  }
  .instructions li {
    padding-left: 0.25rem;
  }
  .instructions strong {
    color: var(--ink);
  }
  .playtest-note {
    max-width: 760px;
    color: var(--muted);
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .playtest-note code {
    color: var(--ink);
  }
  .older-builds {
    margin-top: 30px;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .older-builds summary {
    width: fit-content;
    cursor: pointer;
  }
  .older-builds a {
    display: inline-block;
    margin: 8px 0 0 14px;
    color: var(--muted);
  }
</style>
