---
import Base from '../layouts/Base.astro';

const description =
  'The Waystone asks what you lost. Climb a shifting tower to reclaim it. Choose a starting weapon, fight through three floors, and collect four keys on each floor to open the boss gate.';

const windowsUrl =
  'https://downloads.prathersoftware.com/what-the-tower-keeps/alpha-0.3/windows/Directors-Cut-Alpha-0.3-Win64-Development.zip';
const macUrl =
  'https://downloads.prathersoftware.com/what-the-tower-keeps/alpha-0.3/macos/PratherSoftware_WhatTheTowerKeeps.zip';
---

<Base
  title="What the Tower Keeps — Alpha 0.3 | Prather Software"
  description={description}
  noindex
>
  <section class="section">
    <div class="wrap tower-page">
      <p class="eyebrow">Prather Software / Game prototype</p>
      <h1>What the Tower Keeps</h1>
      <p class="description">{description}</p>

      <section class="downloads" aria-label="Alpha 0.3 downloads">
        <div class="download-option primary-option">
          <h2>
            Windows 64-bit <span>Alpha 0.3</span>
          </h2>
          <a class="download-button" href={windowsUrl}>
            Download Alpha 0.3 for Windows
          </a>
          <p class="availability">ZIP size: 719.5 MiB (754,312,433 bytes)</p>
          <p class="setup">
            Extract the entire ZIP, then run <code>Play Directors Cut.cmd</code>
            from the extracted folder.
          </p>
        </div>

        <div class="download-option secondary-option">
          <h2>
            macOS <span>Alpha 0.3</span>
          </h2>
          <a class="download-button secondary-button" href={macUrl}>
            Download Alpha 0.3 for macOS
          </a>
          <p class="availability">ZIP size: 643.1 MiB (674,336,637 bytes)</p>
          <p class="setup">
            Extract the entire ZIP, then open{' '}
            <code>Play What the Tower Keeps.command</code>. Keep the launcher
            next to <code>EpicAIMegaJam.app</code>.
          </p>
        </div>
      </section>

      <details class="older-builds">
        <summary>Older builds</summary>
        <a href="https://downloads.prathersoftware.com/Directors-Cut-Alpha-0.2-Win64-Development.zip">
          Alpha 0.2 for Windows
        </a>
        <a href="https://downloads.prathersoftware.com/DirectorCut-TowerPrototype-Alpha-0.1-Win64.zip">
          Alpha 0.1 for Windows
        </a>
      </details>
    </div>
  </section>
</Base>
<style>
  .tower-page {
    max-width: 850px;
    padding-block: clamp(28px, 6vw, 72px);
  }
  h1 {
    max-width: 780px;
  }
  .description {
    max-width: 740px;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.8;
  }
  .downloads {
    display: grid;
    gap: clamp(24px, 5vw, 40px);
    max-width: 760px;
    margin-top: 34px;
  }
  .download-option {
    min-width: 0;
  }
  .download-option h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 14px;
    margin: 0 0 14px;
    font-size: clamp(1.3rem, 3vw, 1.7rem);
  }
  .download-option h2 span {
    color: var(--muted);
    font: 600 0.72rem/1.4 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .download-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 430px);
    min-height: 58px;
    padding: 15px 22px;
    border: 1px solid var(--brand);
    border-radius: 2px;
    background: var(--brand);
    color: var(--white);
    font-weight: 650;
    font-size: 1rem;
    text-align: center;
    text-decoration: none;
  }
  .download-button:hover {
    background: var(--brand-hover);
  }
  .secondary-button {
    background: transparent;
    color: var(--brand);
  }
  .secondary-button:hover {
    background: color-mix(in srgb, var(--brand) 8%, transparent);
  }
  .availability,
  .setup {
    max-width: 650px;
    margin: 11px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .setup {
    margin-top: 14px;
    font-size: 1rem;
  }
  .setup code {
    color: var(--ink);
  }
  .older-builds {
    width: fit-content;
    margin-top: 34px;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .older-builds summary {
    cursor: pointer;
  }
  .older-builds a {
    display: block;
    margin: 8px 0 0 14px;
    color: var(--muted);
  }
</style>
