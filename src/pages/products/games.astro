---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
const games = (await getCollection('games', ({ data }) => data.published)).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---

<Base
  title="NinjaDawg Studios Games | Prather Software"
  description="Explore Promenade, Rick Dangerman (& the Cuboids) Remastered, and Floor 13 in Prather Software’s independent game catalog."
>
  <PageHero
    eyebrow="Products / Games"
    title="Original games. Different worlds."
    description="Explore our mobile, PC, and VR games. NinjaDawg Studios is Prather Software’s internal game development and publishing label."
  />
  <section class="section">
    <div class="wrap">
      {games.length > 0 ? (
        <div class="grid">
          {games.map((entry) => (
            <ProductCard entry={entry} category="games" />
          ))}
        </div>
      ) : (
        <article class="card empty-state">
          <p class="eyebrow">Catalog in development</p>
          <h2>Our next chapter is taking shape.</h2>
          <p>
            No public game releases are listed yet. Titles, screenshots,
            supported platforms, pricing, and store links will be published only
            when verified.
          </p>
          <a class="text-link" href="/contact/">
            Ask about NinjaDawg Studios <span aria-hidden="true">↗</span>
          </a>
        </article>
      )}
      <p>
        <a class="text-link" href="/products/">
          ← All products
        </a>
      </p>
    </div>
  </section>
</Base>
<style>
  .empty-state {
    max-width: 780px;
  }
  .empty-state h2 {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    margin-bottom: 1rem;
  }
</style>
