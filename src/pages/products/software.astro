---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
const products = (
  await getCollection('software', ({ data }) => data.published)
).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---

<Base
  title="Software & Utilities | Prather Software"
  description="Explore Quest Theater, a utility for theater-style viewing on Meta Quest with AirPlay casting from iPhone and Android casting support planned."
>
  <PageHero
    eyebrow="Products / Software"
    title="Useful tools for everyday problems."
    description="Independent applications and utilities, built with the same attention to practical design and maintainable engineering as our client work."
  />
  <section class="section">
    <div class="wrap">
      {products.length > 0 ? (
        <div class="grid">
          {products.map((entry) => (
            <ProductCard entry={entry} category="software" />
          ))}
        </div>
      ) : (
        <article class="card empty-state">
          <p class="eyebrow">Catalog in development</p>
          <h2>No public products listed yet.</h2>
          <p>
            Verified software details, platforms, pricing, and release links
            will be added when available. There are no downloads or purchases
            available here today.
          </p>
          <a class="text-link" href="/contact/">
            Ask about software <span aria-hidden="true">↗</span>
          </a>
        </article>
      )}
      <p>
        <a class="text-link" href="/products/">
          ← All products
        </a>
      </p>
    </div>
  </section>
</Base>
<style>
  .empty-state {
    max-width: 780px;
  }
  .empty-state h2 {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    margin-bottom: 1rem;
  }
</style>
