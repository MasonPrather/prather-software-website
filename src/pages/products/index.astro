---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---

<Base
  title="Independent Software & Games | Prather Software"
  description="Explore Prather Software’s independent publishing: useful software applications and original games under NinjaDawg Studios. Discover Quest Theater, Promenade, Rick Dangerman Remastered, and Floor 13."
>
  <PageHero
    eyebrow="Products / Independent publishing"
    title="Independent ideas. Carefully engineered."
    description="Alongside client engineering, Prather Software develops original software and games. Explore the two sides of our publishing work."
  />
  <section class="section">
    <div class="wrap">
      <div class="grid">
        <a class="card" href="/products/software/">
          <p class="eyebrow">Software</p>
          <h2>
            Useful applications. <span aria-hidden="true">↗</span>
          </h2>
          <p>
            Consumer applications and utilities designed around everyday
            problems.
          </p>
          <span class="text-link">Explore software</span>
        </a>
        <a class="card" href="/products/games/">
          <p class="eyebrow">NinjaDawg Studios</p>
          <h2>
            Original games. <span aria-hidden="true">↗</span>
          </h2>
          <p>
            Independent game development and publishing under the Prather
            Software umbrella.
          </p>
          <span class="text-link">Explore games</span>
        </a>
      </div>
      <p class="muted catalog-note">
        Explore current product overviews and platform plans. Availability,
        pricing, and official store links are listed only when confirmed.
      </p>
      <aside class="business-note">
        <h2>Software for your business.</h2>
        <p>
          Website design, custom PC and mobile applications, SaaS, server
          support, AI integration, and ongoing technical service for contracted
          implementations.
        </p>
        <a class="text-link" href="/services/">
          Explore software services <span aria-hidden="true">↗</span>
        </a>
      </aside>
    </div>
  </section>
</Base>
<style>
  .card h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    margin-block: 1rem;
  }
  .business-note {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .business-note h2 {
    font-size: 2rem;
  }
  .catalog-note {
    max-width: 800px;
    margin-top: 2rem;
  }
</style>
