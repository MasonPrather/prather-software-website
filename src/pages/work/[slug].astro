---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
export async function getStaticPaths() {
  return (await getCollection('work', ({ data }) => data.published)).map(
    (entry) => ({ params: { slug: entry.id }, props: { entry } }),
  );
}
interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const isClient = entry.data.category === 'Prather Software client engagement';
---

<Base
  title={`${entry.data.title} | Prather Software`}
  description={entry.data.summary}
>
  <PageHero
    eyebrow={entry.data.category}
    title={entry.data.title}
    description={entry.data.summary}
  />
  <section class="section">
    <div class="wrap detail">
      <a class="text-link" href="/work/">
        ← All engineering experience
      </a>
      <dl class="facts">
        <div>
          <dt>Context</dt>
          <dd>{entry.data.category}</dd>
        </div>
        <div>
          <dt>Contribution</dt>
          <dd>{entry.data.role}</dd>
        </div>
        <div>
          <dt>Outcome</dt>
          <dd>{entry.data.outcome}</dd>
        </div>
      </dl>
      <div role="list" aria-label="Technologies">
        {entry.data.technologies.map((technology) => (
          <span role="listitem" class="tag">
            {technology}
          </span>
        ))}
      </div>
      <div class="prose">
        <Content />
      </div>
      {!isClient && (
        <aside class="attribution">
          <h2>Attribution</h2>
          <p>
            This project documents Mason Prather’s{' '}
            {entry.data.category.toLowerCase()}. It is not a Prather Software
            client engagement, and does not imply a commercial relationship,
            partnership, or endorsement.
          </p>
        </aside>
      )}
    </div>
  </section>
  <ContactCTA title="Working through a similar technical challenge?" />
</Base>
<style>
  .detail {
    max-width: 820px;
  }
  .facts {
    margin-block: 2.5rem;
    display: grid;
    gap: 1.5rem;
  }
  dt {
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  dd {
    margin: 0;
    line-height: 1.8;
  }
  .prose {
    margin-block: 3rem;
    line-height: 1.8;
  }
  .attribution {
    padding: 1.5rem;
    border-left: 3px solid #b51e38;
    background: #ededeb;
  }
  .attribution h2 {
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
  }
  .attribution p {
    margin: 0;
    line-height: 1.8;
  }
</style>
