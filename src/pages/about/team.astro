---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
---

<Base
  title="Our Team — Mason Prather, Founder | Prather Software"
  description="Meet Mason Prather, founder of Prather Software LLC, leading client software engineering and independent application and game development."
>
  <PageHero
    eyebrow="Our Team"
    title="Founder-led. Engineering-focused."
    description="Prather Software is currently led by its founder, Mason Prather. The company’s direction brings together custom software engineering and independent product development."
  />
  <section class="section">
    <div class="wrap">
      <article class="card founder">
        <p class="eyebrow">Founder / Software engineering</p>
        <h2>Mason Prather</h2>
        <p>
          Mason leads Prather Software’s client software engineering and
          independent product development, bringing together business
          applications, useful utilities, and games.
        </p>
        <p>
          The company offers custom software services for businesses and
          develops original products under Prather Software and NinjaDawg
          Studios.
        </p>
        <div class="founder-links">
          <a class="text-link" href="/services/">
            Explore our services <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/products/">
            Discover our products <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </div>
  </section>
  <ContactCTA title="Start with a clear conversation." />
</Base>
<style>
  .founder {
    max-width: 820px;
  }
  .founder h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1.25rem;
  }
  .founder-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
