---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
---

<Base
  title="Our Team — Mason Prather, Founder | Prather Software"
  description="Meet Mason Prather, founder of Prather Software LLC, with engineering experience across XR development, applications, real-time systems, and research software."
>
  <PageHero
    eyebrow="Our Team"
    title="Founder-led. Engineering-focused."
    description="Prather Software is currently led by its founder, Mason Prather. The company’s direction brings together custom software engineering and independent product development."
  />
  <section class="section">
    <div class="wrap">
      <article class="card founder">
        <p class="eyebrow">Founder / Software engineering</p>
        <h2>Mason Prather</h2>
        <p>
          Software engineer with experience across XR development, full-stack
          applications, real-time systems, and engineering research.
        </p>
        <p>
          Selected work on this site documents academic research and prior
          professional engineering. Those contributions are identified
          separately from Prather Software client engagements.
        </p>
        <div class="founder-links">
          <a class="text-link" href="/work/">
            View selected experience <span aria-hidden="true">↗</span>
          </a>
          <a
            class="text-link"
            href="https://masonprather.github.io/Portfolio/"
            rel="noopener noreferrer"
          >
            Prior engineering portfolio <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </div>
  </section>
  <ContactCTA title="Start with a clear conversation." />
</Base>
<style>
  .founder {
    max-width: 820px;
  }
  .founder h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1.25rem;
  }
  .founder-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
