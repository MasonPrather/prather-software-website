---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Prather Software"
  description="Find your way back to Prather Software engineering services and independent software and games."
  noindex
>
  <section class="pagehero">
    <div class="wrap">
      <p class="eyebrow">404 / PAGE NOT FOUND</p>
      <h1>Let's get you back on track.</h1>
      <p>This page may have moved, or the address may be incorrect.</p>
      <a class="button" href="/">
        Back to Home <span aria-hidden="true">↗</span>
      </a>
      <a class="button outline" href="/services/">
        Explore Services <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>
