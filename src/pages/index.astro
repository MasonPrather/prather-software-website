---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { services } from '../data';
import { getCollection } from 'astro:content';
const projects = (
  await getCollection('work', ({ data }) => data.published)
).sort((a, b) => a.data.title.localeCompare(b.data.title));
const process = [
  [
    'Understand the problem',
    'Start with your goals, the people using the software, and the constraints that matter.',
  ],
  [
    'Design the right system',
    'Map the architecture, agree on priorities, and make the path to delivery clear.',
  ],
  [
    'Build. Test. Refine.',
    'Develop in focused increments, validate the details, and keep you involved.',
  ],
  [
    'Deliver and evolve',
    'Prepare for deployment, document the system, and plan for what comes next.',
  ],
];
---

<Base>
  <section class="hero dark">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="status-dot" aria-hidden="true"></span> INDEPENDENT
          ENGINEERING & PUBLISHING
        </p>
        <h1>
          Built for business.
          <br />
          <span>
            Designed for
            <br class="desktop-break" /> what’s next.
          </span>
        </h1>
        <p class="hero-description muted">
          Purposeful software for your business. Original products for everyday
          life. One independent engineering company, built to bring both to
          life.
        </p>
        <div class="button-row">
          <a class="button" href="/contact/">
            Discuss your project <span aria-hidden="true">↗</span>
          </a>
          <a class="button outline" href="/products/">
            Explore our products <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="engineering-art" aria-hidden="true">
        <div class="art-coordinate">PS / SYSTEM_01</div>
        <svg viewBox="0 0 360 360" fill="none">
          <path
            class="art-grid"
            d="M0 60h360M0 120h360M0 180h360M0 240h360M0 300h360M60 0v360M120 0v360M180 0v360M240 0v360M300 0v360"
          />
          <path
            class="art-frame"
            d="M60 140V60h80M220 60h80v80M300 220v80h-80M140 300H60v-80"
          />
          <path
            class="art-shadow"
            d="M132 278V102h89l45 44v61l-45 44h-44v27h-45Z"
          />
          <path
            class="art-letter"
            d="M108 254V78h89l45 44v61l-45 44h-44v27h-45Zm45-72h26l18-18v-23l-18-18h-26v59Z"
          />
          <path class="art-guide" d="M0 254h360M108 0v360" />
          <circle cx="108" cy="254" r="4" fill="#f2768c" />
        </svg>
        <div class="art-caption">
          <span>
            THOUGHTFULLY DESIGNED.
            <br />
            CAREFULLY ENGINEERED.
          </span>
          <span class="art-plus">+</span>
        </div>
      </div>
    </div>
    <div class="wrap hero-strip">
      <span>01 / CLIENT SOFTWARE SOLUTIONS</span>
      <span>02 / INDEPENDENT PUBLISHING</span>
      <span class="strip-end">IDEA → ENGINEERING → IMPACT</span>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="01 / ONE COMPANY. TWO DIRECTIONS."
        title="The right software changes what’s possible."
        description="We build custom systems for businesses and develop original software and games. Both start with a real problem, a clear purpose, and careful engineering."
      />
      <div class="grid business-grid">
        <a class="card business-card" href="/services/">
          <span class="business-number" aria-hidden="true">
            01
          </span>
          <p class="eyebrow">FOR YOUR BUSINESS</p>
          <h3>
            Client software solutions <span aria-hidden="true">↗</span>
          </h3>
          <p>
            Applications, infrastructure, automation, and specialized
            engineering shaped around how your business works.
          </p>
          <span class="card-link">
            Explore our services <span aria-hidden="true">↗</span>
          </span>
        </a>
        <a class="card business-card" href="/products/">
          <span class="business-number" aria-hidden="true">
            02
          </span>
          <p class="eyebrow">FROM OUR STUDIO</p>
          <h3>
            Independent publishing <span aria-hidden="true">↗</span>
          </h3>
          <p>
            Original applications, useful utilities, and games developed under
            Prather Software and NinjaDawg Studios.
          </p>
          <span class="card-link">
            Discover our products <span aria-hidden="true">↗</span>
          </span>
        </a>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap">
      <div class="heading-row">
        <SectionHeading
          eyebrow="02 / ENGINEERING CAPABILITIES"
          title="From interface to infrastructure."
        />
        <a class="text-link" href="/services/">
          All services <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="grid capability-grid">
        {services.map(([title, description], index) => (
          <article class="capability">
            <span class="capability-index" aria-hidden="true">
              0{index + 1}
            </span>
            <div>
              <h3>{title}</h3>
              <p class="muted">{description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="heading-row">
        <SectionHeading
          eyebrow="03 / SELECTED EXPERIENCE"
          title="Engineering in practice."
          description="A look at the founder’s academic research and prior professional experience. These projects are distinguished from Prather Software client engagements."
        />
        <a class="text-link" href="/work/">
          Our work <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="work-grid">
        {projects.map((project) => (
          <a class="card work-card" href={`/work/${project.id}/`}>
            <p class="eyebrow">{project.data.category}</p>
            <h3>
              {project.data.title} <span aria-hidden="true">↗</span>
            </h3>
            <p>{project.data.summary}</p>
            <span class="card-link">
              View experience <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section dark publishing-section">
    <div class="wrap">
      <SectionHeading
        eyebrow="04 / INDEPENDENT PRODUCTS"
        title="Built from our own curiosity."
        description="Alongside client engineering, we’re developing a home for original software and games. Public releases will appear here when verified details are ready."
      />
      <div class="grid">
        <a class="publishing-card" href="/products/software/">
          <div class="product-category">
            <span aria-hidden="true">[ S ]</span>
            <span class="eyebrow">SOFTWARE / CATALOG IN DEVELOPMENT</span>
          </div>
          <h3>
            Useful software.
            <br />
            Everyday possibilities.
          </h3>
          <p class="muted">
            Consumer applications and utilities from Prather Software.
          </p>
          <span class="card-link">
            Explore software <span aria-hidden="true">↗</span>
          </span>
        </a>
        <a class="publishing-card" href="/products/games/">
          <div class="product-category">
            <span aria-hidden="true">[ G ]</span>
            <span class="eyebrow">GAMES / CATALOG IN DEVELOPMENT</span>
          </div>
          <h3>
            Independent games.
            <br />A different kind of play.
          </h3>
          <p class="muted">Original games under our NinjaDawg Studios label.</p>
          <span class="card-link">
            Explore games <span aria-hidden="true">↗</span>
          </span>
        </a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="05 / HOW WE WORK"
        title="A clear path from idea to delivery."
      />
      <ol class="process-grid" role="list">
        {process.map(([title, description], index) => (
          <li>
            <span class="eyebrow" aria-hidden="true">
              0{index + 1} /
            </span>
            <h3>{title}</h3>
            <p class="muted">{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section cta">
    <div class="wrap cta-inner">
      <div>
        <p class="eyebrow">LET’S BUILD SOMETHING USEFUL</p>
        <h2>Your next software challenge starts with a conversation.</h2>
        <p>Tell us what you have in mind. We’ll help define the next step.</p>
      </div>
      <a class="button light" href="/contact/">
        Start a project inquiry <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>
<style>
  .hero {
    padding: 78px 0 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .hero-copy {
    padding: 12px 0 48px;
  }
  .hero h1 {
    font-size: clamp(3rem, 5.3vw, 5.1rem);
    letter-spacing: -0.055em;
    line-height: 1.06;
    margin: 25px 0 25px;
  }
  .hero h1 > span {
    color: var(--accent);
  }
  .hero .eyebrow {
    font-size: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 0.1em;
  }
  .status-dot {
    height: 6px;
    width: 6px;
    flex-shrink: 0;
    background: var(--accent);
  }
  .hero-description {
    max-width: 550px;
    font-size: 1.03rem;
    margin: 0 0 30px;
  }
  .engineering-art {
    align-self: center;
    position: relative;
    border: 1px solid #414149;
    aspect-ratio: 1;
    max-width: 400px;
    background: #19191e;
  }
  .engineering-art svg {
    position: absolute;
    inset: 24px;
    width: calc(100% - 48px);
    height: calc(100% - 48px);
  }
  .art-grid {
    stroke: #2a2a31;
    stroke-width: 1;
  }
  .art-frame {
    stroke: #898994;
    stroke-width: 1;
  }
  .art-shadow {
    fill: #551526;
  }
  .art-letter {
    fill: #b01d38;
    fill-rule: evenodd;
  }
  .art-guide {
    stroke: #c34c64;
    stroke-width: 1;
    stroke-dasharray: 3 7;
    opacity: 0.6;
  }
  .art-coordinate {
    position: absolute;
    left: 20px;
    top: 15px;
    font: 9px var(--mono);
    letter-spacing: 0.12em;
    color: #b7b7c2;
  }
  .art-caption {
    position: absolute;
    bottom: 17px;
    left: 20px;
    right: 20px;
    display: flex;
    justify-content: space-between;
    align-items: end;
    font: 9px/1.6 var(--mono);
    letter-spacing: 0.07em;
    color: #b7b7c2;
  }
  .art-plus {
    font-size: 24px;
    color: #f2768c;
  }
  .hero-strip {
    display: flex;
    gap: 30px;
    border-top: 1px solid #414149;
    padding-block: 24px;
    font: 9px/1.7 var(--mono);
    letter-spacing: 0.09em;
    color: #bcbcc5;
  }
  .strip-end {
    margin-left: auto;
    color: #8e8e9b;
  }
  .business-card {
    position: relative;
    padding: 38px;
  }
  .business-card h3 {
    font-size: 1.8rem;
    max-width: 360px;
    margin-top: 25px;
  }
  .business-number {
    position: absolute;
    right: 30px;
    top: 28px;
    color: #77736d;
    font: 32px var(--mono);
    font-weight: 400;
  }
  .business-card p:not(.eyebrow) {
    max-width: 430px;
  }
  .card-link {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-top: 28px;
  }
  .heading-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 30px;
  }
  .heading-row > .text-link {
    flex-shrink: 0;
    margin-top: 26px;
  }
  .capability-grid {
    gap: 0 56px;
  }
  .capability {
    display: flex;
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid #c9c8c4;
  }
  .capability-index {
    font: 11px var(--mono);
    color: #a42139;
    margin-top: 8px;
  }
  .capability h3 {
    margin: 0 0 14px;
    font-size: 1.4rem;
  }
  .capability p {
    font-size: 0.95rem;
    margin: 0;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .work-card {
    display: flex !important;
    flex-direction: column;
    padding: 28px;
  }
  .work-card h3 {
    font-size: 1.5rem;
    margin: 12px 0 16px;
  }
  .work-card p {
    font-size: 0.9rem;
  }
  .work-card .eyebrow {
    font-size: 9px;
    margin-bottom: 0;
  }
  .work-card .card-link {
    margin-top: auto;
    padding-top: 28px;
  }
  .publishing-card {
    display: block;
    border: 1px solid #4b4b53;
    padding: 34px;
    color: white;
    text-decoration: none;
    transition:
      border-color 0.18s,
      background 0.18s;
  }
  .publishing-card:hover {
    border-color: var(--accent);
    background: #1c1c22;
  }
  .publishing-card h3 {
    font-size: 2.1rem;
    line-height: 1.15;
    margin-top: 30px;
  }
  .publishing-card p {
    font-size: 0.95rem;
  }
  .product-category {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .product-category > span:first-child {
    font: 23px var(--mono);
    color: #f2768c;
    white-space: nowrap;
  }
  .product-category .eyebrow {
    font-size: 9px;
    margin: 0;
    letter-spacing: 0.07em;
  }
  .publishing-card .card-link {
    border-top: 1px solid #4b4b53;
    padding-top: 20px;
    margin-top: 28px;
  }
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    list-style: none;
    gap: 30px;
    counter-reset: steps;
  }
  .process-grid li {
    border-top: 1px solid #bcbab6;
    padding-top: 23px;
  }
  .process-grid h3 {
    font-size: 1.35rem;
    line-height: 1.2;
    max-width: 210px;
    margin: 22px 0 14px;
  }
  .process-grid p {
    font-size: 0.88rem;
    margin: 0;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
  }
  .cta-inner > div {
    max-width: 740px;
  }
  .cta h2 {
    font-size: clamp(2.1rem, 3.5vw, 3.2rem);
    margin-bottom: 20px;
  }
  .cta .button {
    flex-shrink: 0;
  }
  .cta p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 1080px) {
    .hero-grid {
      gap: 35px;
      grid-template-columns: 1.5fr 1fr;
    }
    .hero h1 {
      font-size: clamp(3rem, 5.7vw, 4.8rem);
    }
    .hero .eyebrow {
      font-size: 9px;
    }
    .hero-strip {
      gap: 20px;
      font-size: 8px;
    }
    .work-grid {
      gap: 14px;
    }
    .work-card {
      padding: 23px;
    }
    .work-card h3 {
      font-size: 1.3rem;
    }
    .cta-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 28px;
    }
  }
  @media (max-width: 800px) {
    .hero {
      padding-top: 50px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      padding-bottom: 40px;
    }
    .engineering-art {
      display: none;
    }
    .hero h1 {
      font-size: clamp(3.25rem, 8.5vw, 5rem);
      max-width: 700px;
    }
    .desktop-break {
      display: none;
    }
    .hero-description {
      max-width: 640px;
    }
    .hero-strip {
      flex-wrap: wrap;
      gap: 12px 24px;
      font-size: 8px;
    }
    .strip-end {
      margin-left: 0;
    }
    .work-grid {
      grid-template-columns: 1fr;
    }
    .work-card h3 {
      font-size: 1.5rem;
    }
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px;
    }
    .heading-row {
      display: block;
    }
    .heading-row > .text-link {
      margin: 0 0 24px;
    }
    .heading-row .section-heading {
      margin-bottom: 12px;
    }
  }
  @media (max-width: 750px) {
    .hero h1 {
      font-size: clamp(3rem, 10vw, 4.5rem);
    }
    .business-card {
      padding: 28px;
    }
    .business-card h3 {
      font-size: 1.65rem;
      max-width: 290px;
    }
    .business-number {
      right: 24px;
      top: 22px;
      font-size: 25px;
    }
    .capability-grid {
      gap: 0;
    }
    .capability {
      padding: 25px 0;
      gap: 18px;
    }
    .capability-index {
      margin-top: 5px;
    }
    .publishing-card {
      padding: 26px;
    }
    .publishing-card h3 {
      font-size: 1.85rem;
    }
    .product-category .eyebrow {
      font-size: 8px;
    }
    .process-grid {
      gap: 24px 20px;
    }
    .process-grid h3 {
      font-size: 1.2rem;
    }
    .hero .eyebrow {
      font-size: 8px;
      letter-spacing: 0.03em;
      gap: 8px;
    }
  }
  @media (max-width: 380px) {
    .hero h1 {
      font-size: 2.85rem;
    }
    .process-grid {
      grid-template-columns: 1fr;
    }
    .product-category {
      gap: 10px;
    }
  }
</style>
