---
import Base from '../layouts/Base.astro';import {services,projects} from '../data';
---
<Base><section class="hero dark"><div class="wrap hero-grid"><div><div class="eyebrow">INDEPENDENT ENGINEERING & PUBLISHING</div><h1>Built for business.<br/><em>Designed for what's next.</em></h1><p class="muted" style="font-size:1.2rem;max-width:660px">From the systems behind your business to the products in your hands, we design, engineer, and deliver software that solves real problems.</p><a class="button" href="/services">Explore Our Services ↗</a><a class="button outline" href="/products">Discover Our Products ↗</a></div><div class="art" aria-hidden="true"><div class="glyph">P</div><small>DESIGN / DEVELOP / DEPLOY</small></div></div><div class="wrap strip"><span>END-TO-END ENGINEERING</span><span>INDEPENDENT DIGITAL PRODUCTS</span><span>BUILT WITH PURPOSE</span></div></section><section class="section"><div class="wrap"><div class="eyebrow">01 / WHAT WE DO</div><h2>Two directions.<br/>One engineering foundation.</h2><div class="grid"><a class="card" href="/services"><div class="eyebrow">B2B / ENGINEERING</div><h3>Client software solutions ↗</h3><p>Full-stack development, infrastructure, integrations, and custom systems designed around your operations.</p></a><a class="card" href="/products"><div class="eyebrow">B2C / PUBLISHING</div><h3>Original digital products ↗</h3><p>Useful consumer applications, software utilities, and original games built and published independently.</p></a></div></div></section><section class="section alt"><div class="wrap"><div class="eyebrow">02 / CAPABILITIES</div><h2>From interface to infrastructure.</h2><div class="grid">{services.map(([title,description],i)=><article class="card"><div class="eyebrow">0{i+1} / CAPABILITY</div><h3>{title}</h3><p>{description}</p></article>)}</div></div></section><section class="section"><div class="wrap"><div class="eyebrow">03 / SELECTED EXPERIENCE</div><h2>Engineering in practice.</h2><p class="muted">Prior academic and professional experience, clearly distinguished from Prather Software client engagements.</p><div class="grid">{projects.map(([title,type,description])=><article class="card"><div class="eyebrow">{type}</div><h3>{title}</h3><p>{description}</p></article>)}</div><p><a href="/work">Explore Our Work ↗</a></p></div></section><section class="section alt"><div class="wrap"><div class="eyebrow">04 / DIGITAL PRODUCTS</div><h2>Software and games. Independently imagined.</h2><div class="grid"><a class="card" href="/products/software"><div class="eyebrow">SOFTWARE</div><h3>Everyday tools ↗</h3><p>Consumer software catalog in development.</p></a><a class="card" href="/products/games"><div class="eyebrow">NINJADAWG STUDIOS</div><h3>Original games ↗</h3><p>Independent games catalog in development.</p></a></div></div></section><section class="section dark"><div class="wrap"><div class="eyebrow">05 / PROCESS</div><h2>From concept to deployment.</h2><div class="grid">{['Discover the problem','Design the solution','Build and validate','Deploy and evolve'].map((step,i)=><div class="card" style="background:#22232a;border-color:#444;color:white"><div class="eyebrow">0{i+1}</div><h3>{step}</h3></div>)}</div></div></section><section class="section cta"><div class="wrap"><div class="eyebrow">START A CONVERSATION</div><h2>Have a software challenge?</h2><p>Tell us what you're building. Let's explore the right technical approach.</p><a class="button" style="background:white;color:#9c172f;border-color:white" href="/contact">Start a Project Inquiry ↗</a></div></section></Base><style>.hero{padding:110px 0 30px;overflow:hidden}.hero-grid{display:grid;grid-template-columns:1.6fr 1fr;align-items:center;gap:30px;min-height:450px}.hero h1 em{font-style:normal;color:#e65a70}.art{min-height:350px;display:grid;place-items:center;position:relative;background:repeating-linear-gradient(0deg,transparent,transparent 35px,#ffffff0b 36px),repeating-linear-gradient(90deg,transparent,transparent 35px,#ffffff0b 36px);border:1px solid #303139}.glyph{font:700 17rem 'Space Grotesk';color:#b51e38;transform:rotate(-10deg);text-shadow:18px 18px 0 #561522}.art small{position:absolute;bottom:20px;letter-spacing:.2em;color:#aaa}.strip{display:flex;justify-content:space-between;gap:20px;padding-top:55px;font-size:.7rem;letter-spacing:.12em;color:#a2a3ac}.card:hover{border-color:#b51e38}@media(max-width:850px){.hero-grid{grid-template-columns:1fr}.art{display:none}.strip{flex-wrap:wrap}.hero{padding:80px 0 30px}}</style>
