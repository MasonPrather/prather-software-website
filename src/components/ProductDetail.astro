---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
interface Props {
  entry: CollectionEntry<'software'> | CollectionEntry<'games'>;
  category: 'software' | 'games';
}
const { entry, category } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={`${entry.data.title} | Prather Software`}
  description={entry.data.summary}
>
  <PageHero
    eyebrow={entry.data.status}
    title={entry.data.title}
    description={entry.data.summary}
  />
  <section class="section">
    <div class="wrap product-detail">
      <dl class="facts">
        <div>
          <dt>Platforms</dt>
          <dd>{entry.data.platforms.join(', ')}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{entry.data.status}</dd>
        </div>
        {entry.data.price && (
          <div>
            <dt>Price</dt>
            <dd>{entry.data.price}</dd>
          </div>
        )}
        {category === 'games' && (
          <div>
            <dt>Publishing label</dt>
            <dd>NinjaDawg Studios · Prather Software LLC</dd>
          </div>
        )}
      </dl>
      {entry.data.cover && (
        <img
          src={entry.data.cover}
          alt={`${entry.data.title} product preview`}
          loading="lazy"
        />
      )}
      <div class="prose">
        <Content />
      </div>
      {entry.data.status === 'Released' && entry.data.storeUrl && (
        <a class="button" href={entry.data.storeUrl} rel="noopener noreferrer">
          Visit official product listing <span aria-hidden="true">↗</span>
        </a>
      )}
      <p>
        <a class="text-link" href={`/products/${category}/`}>
          ← Back to {category}
        </a>
      </p>
    </div>
  </section>
</Base>
<style>
  .product-detail {
    max-width: 820px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0 0 3rem;
  }
  dt {
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  dd {
    margin: 0;
    line-height: 1.6;
  }
  img {
    max-width: 100%;
    height: auto;
  }
  .prose {
    margin-block: 2rem;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
