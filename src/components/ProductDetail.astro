---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
interface Props {
  entry: CollectionEntry<'software'> | CollectionEntry<'games'>;
  category: 'software' | 'games';
}
const { entry, category } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={`${entry.data.title} | Prather Software`}
  description={entry.data.summary}
>
  <PageHero
    eyebrow={entry.data.productType ?? entry.data.status}
    title={entry.data.title}
    description={entry.data.summary}
  />
  <section class="section">
    <div class="wrap product-detail">
      <dl class="facts">
        <div>
          <dt>Platforms</dt>
          <dd>{entry.data.platforms.join(', ')}</dd>
        </div>
        <div>
          <dt>Availability</dt>
          <dd>{entry.data.status}</dd>
        </div>
        {entry.data.releaseWindow && (
          <div>
            <dt>Planned release week</dt>
            <dd>{entry.data.releaseWindow}</dd>
          </div>
        )}
        {entry.data.price && (
          <div>
            <dt>Price</dt>
            <dd>{entry.data.price}</dd>
          </div>
        )}
        {entry.data.publishingLabel && (
          <div>
            <dt>Publishing label</dt>
            <dd>{entry.data.publishingLabel}</dd>
          </div>
        )}
      </dl>
      {entry.data.cover && (
        <img
          src={entry.data.cover}
          alt={`${entry.data.title} product preview`}
          loading="lazy"
        />
      )}
      <div class="prose">
        <Content />
      </div>
      {entry.data.plannedSupport.length > 0 && (
        <aside class="planned-support">
          <h2>Planned support</h2>
          <ul>
            {entry.data.plannedSupport.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          {entry.data.roadmapNote && <p>{entry.data.roadmapNote}</p>}
        </aside>
      )}
      {entry.data.status !== 'Released' && (
        <p class="muted availability-note">
          Pricing and official download links will be added here when confirmed.
        </p>
      )}
      {entry.data.status === 'Released' && entry.data.storeUrl && (
        <a class="button" href={entry.data.storeUrl} rel="noopener noreferrer">
          Visit official product listing <span aria-hidden="true">↗</span>
        </a>
      )}
      <p>
        <a class="text-link" href={`/products/${category}/`}>
          ← Back to {category}
        </a>
      </p>
    </div>
  </section>
</Base>
<style>
  .planned-support {
    border-left: 3px solid var(--crimson);
    padding: 1.25rem 1.5rem;
    background: #eeede9;
    margin-block: 2rem;
  }
  .planned-support h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }
  .planned-support ul {
    padding-left: 1.25rem;
  }
  .planned-support p:last-child {
    margin-bottom: 0;
  }
  .availability-note {
    font-size: 0.9rem;
  }
  .product-detail {
    max-width: 820px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0 0 3rem;
  }
  dt {
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  dd {
    margin: 0;
    line-height: 1.6;
  }
  img {
    max-width: 100%;
    height: auto;
  }
  .prose {
    margin-block: 2rem;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
